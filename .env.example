# Demo config — copy to .env. All values are optional; no Casso keys go here (visitors enter their own on the UI).

# Port the demo server listens on
PORT=3030

# Casso Console API host (same for sandbox and production)
CASSO_BASE_URL=https://api-console.casso.vn

# Upstream timeout in ms when calling Casso Console
CASSO_TIMEOUT_MS=45000

# Public domain of this demo, used for the Redirect/Webhook URLs shown on the UI.
# Set this when deploying publicly; otherwise the browser derives it from the page URL (the server never trusts the Host header).
PUBLIC_BASE_URL=

# Number of reverse proxies in front of the server (ngrok/nginx) trusted for X-Forwarded-*
TRUST_PROXY_HOPS=1

# Max /api, /casso/callback and /casso/webhook requests per IP per minute (generous: many people at one office or event share an IP)
RATE_LIMIT_PER_MIN=300

# Link for the "Mã nguồn" button
GITHUB_URL=https://github.com

# ngrok reserved domain for `npm run tunnel`
NGROK_DOMAIN=
